# didiQCsys Environment Variables (TEMPLATE)
# Copy file ini ke .env dan isi dengan nilai asli
# JANGAN commit file .env ke GitHub!

# Database: InsForge PostgreSQL
# Dapatkan connection string dari dashboard InsForge project Anda
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.ap-southeast.database.insforge.app:5432/insforge?sslmode=require

# (Opsional) Backup SQLite untuk migrasi
SQLITE_DATABASE_URL=file:./db/custom.db

# ============================================================
# Backup & Restore (lihat docs/BACKUP-RESTORE.md)
# Semua nilai asli HANYA di GitHub Secrets / Vercel Environment Variables.
# ============================================================
# Cloudflare R2 (S3-compatible). Bucket existing: didikqc, prefix: database_didiqc
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=didikqc
R2_PREFIX=database_didiqc
# Folder penyimpanan file gambar/dokumen aplikasi (upload via /api/upload,
# akses via /api/files/...). Default: file_image_didiqc
R2_FILE_PREFIX=file_image_didiqc
# Database tujuan restore (opsional; restore default ke staging/Neon, bukan produksi)
NEON_DATABASE_URL=
STAGING_DATABASE_URL=
# Opsional
RETENTION_KEEP=15
BACKUP_ALERT_WEBHOOK=
